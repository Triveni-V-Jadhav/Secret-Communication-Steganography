# Secret Communication Application Environment
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production-min-32-chars
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///instance/application.db

# Storage configuration
MAX_CONTENT_LENGTH_MB=32
UPLOAD_FOLDER=storage/uploads
STEGO_FOLDER=storage/stego_images
TEMP_FOLDER=storage/temporary

# Biometric & Security Settings
FACE_MATCH_THRESHOLD=0.72
ALLOW_INSECURE_FALLBACKS=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
